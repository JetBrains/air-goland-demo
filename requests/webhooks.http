### Valid event
< {%
    const timestamp = Math.floor(Date.now() / 1000);
    const signature = crypto.hmac.sha256()
        .withTextSecret(request.environment.get("secret"))
        .updateWithText(`${timestamp}.${request.body.tryGetSubstituted()}`)
        .digest().toHex();
    request.variables.set("signature", `t=${timestamp},v1=${signature}`);
%}
POST {{host}}/webhooks/stripe
Content-Type: application/json
Webhook-Signature: {{signature}}

{"id": "evt_1A2b3C4d5E6f7G8h9I0jK1lM", "type": "payment.succeeded", "data": {"amount": 2500, "currency": "gbp"}}

> {%
    client.test("New event is accepted", () => {
        client.assert(response.status === 202, `expected 202, got ${response.status}`);
    });
%}

### Duplicate event
< {%
    const timestamp = Math.floor(Date.now() / 1000);
    const signature = crypto.hmac.sha256()
        .withTextSecret(request.environment.get("secret"))
        .updateWithText(`${timestamp}.${request.body.tryGetSubstituted()}`)
        .digest().toHex();
    request.variables.set("signature", `t=${timestamp},v1=${signature}`);
%}
POST {{host}}/webhooks/stripe
Content-Type: application/json
Webhook-Signature: {{signature}}

{"id": "evt_1A2b3C4d5E6f7G8h9I0jK1lM", "type": "payment.succeeded", "data": {"amount": 2500, "currency": "gbp"}}

> {%
    client.test("Duplicate is acknowledged", () => {
        client.assert(response.status === 200, `expected 200, got ${response.status}`);
    });
%}

### Bad signature
POST {{host}}/webhooks/stripe
Content-Type: application/json
Webhook-Signature: t={{$timestamp}},v1=deadbeef

{"id": "evt_9Z8y7X6w5V4u3T2s1R0qP9oN", "type": "payment.succeeded", "data": {"amount": 2500, "currency": "gbp"}}

> {%
    client.test("Bad signature is rejected", () => {
        client.assert(response.status === 401, `expected 401, got ${response.status}`);
    });
%}
